MAJOR = 1
LOCAL = 2
HOSPITALS = (MAJOR, LOCAL)
O_POS = "O+"
O_NEG = "O-"
BLOOD_TYPES = (O_POS, O_NEG)
DEMAND_KEYS = tuple((i, r) for i in HOSPITALS for r in BLOOD_TYPES)

InvKey = Tuple[int, str, int]
DemandKey = Tuple[int, str]
Inventory = Dict[InvKey, int]
Demand = Dict[DemandKey, int]
TransshipmentToday = Dict[str, int]
PricingState = Tuple[int, Inventory, Demand, TransshipmentToday]


def _demand_cost(default: float) -> Dict[DemandKey, float]:
    return {key: default for key in DEMAND_KEYS}


def _trans_cost(default: float) -> Dict[Tuple[int, int, str], float]:
    return {(LOCAL, MAJOR, r): default for r in BLOOD_TYPES}


def _sub_cost(default: float) -> Dict[Tuple[int, str, str], float]:
    return {(i, O_POS, O_NEG): default for i in HOSPITALS}


def _order_up_to_default() -> Dict[DemandKey, int]:
    return {
        (MAJOR, O_POS): 28,
        (MAJOR, O_NEG): 10,
        (LOCAL, O_POS): 10,
        (LOCAL, O_NEG): 4,
    }


@dataclass
class ADPConfig:
    M: int = 5
    gamma: float = 0.98
    major_order_days: Tuple[int, ...] = (0, 2, 4)
    local_order_days: Tuple[int, ...] = (0, 3)
    max_regular_order: int = 40
    max_inventory_per_age: int = 50
    initial_inventory_override: Dict[InvKey, int] = field(default_factory=dict)
    initial_transshipped: Dict[str, int] = field(default_factory=lambda: {O_NEG: 20, O_POS: 10})
    max_actions_per_state: Optional[int] = None
    next_demand_samples: int = 50
    max_exact_demand_joint: int = 5000
    artificial_penalty: float = 1_000_000.0
    enforce_structural_zero_pruning: bool = True
    future_cover_multiplier: float = 1.25
    gurobi_output_flag: int = 0
    gurobi_threads: Optional[int] = None
    gurobi_method: Optional[int] = None
    order_up_to: Dict[DemandKey, int] = field(default_factory=_order_up_to_default)
    regular_cost: Dict[DemandKey, float] = field(default_factory=lambda: _demand_cost(15.0))
    holding_cost: Dict[DemandKey, float] = field(default_factory=lambda: _demand_cost(1.0))
    emergency_cost: Dict[DemandKey, float] = field(default_factory=lambda: _demand_cost(30.0))
    wastage_cost: Dict[DemandKey, float] = field(default_factory=lambda: _demand_cost(3.0))
    transshipment_cost: Dict[Tuple[int, int, str], float] = field(default_factory=lambda: _trans_cost(3.0))
    substitution_cost: Dict[Tuple[int, str, str], float] = field(default_factory=lambda: _sub_cost(2.0))

    def __post_init__(self) -> None:
        if self.M < 3:
            raise ValueError("M must be at least 3.")
        if not (0.0 < self.gamma < 1.0):
            raise ValueError("Use 0 < gamma < 1.")

    def is_order_day(self, hospital: int, k: int) -> bool:
        if hospital == MAJOR:
            return k in self.major_order_days
        if hospital == LOCAL:
            return k in self.local_order_days
        raise ValueError(f"Unknown hospital {hospital}.")


